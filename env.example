# Copiá este archivo como .env y completá con tus datos reales.
# El archivo .env NUNCA se sube a git (ver .gitignore).

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# El token lo da @BotFather. TELEGRAM_CHAT_ID es tu chat personal con el bot:
# escribile y abrí https://api.telegram.org/bot<TU_TOKEN>/getUpdates para verlo.
# Si este ID está mal, recibirás avisos pero el bot ignorará tus comandos.

# --- Panel ---
PANEL_TIMEZONE_LABEL=CET
# Etiqueta que se muestra junto a la hora de última actualización.

PANEL_AUTO_PUSH=false
# En true, el bot hace commit y push de data.json en cada ronda para que
# GitHub Pages se actualice solo. Genera un commit cada 30 minutos.

# --- Resumen diario con IA (opcional) ---
ANTHROPIC_API_KEY=
# Si está vacío, el resumen se arma con reglas a partir de las señales.
